# Copy to .env and adjust. Loaded by `pnpm --filter @hearth/auth-server start|dev`.
PORT=4100
# Public URL of this authorization server (the `iss` claim and metadata base).
HEARTH_AUTH_ISSUER=http://localhost:4100
# Base URL of the MCP server; tokens are issued for the audience ${HEARTH_MCP_BASE}/mcp.
HEARTH_MCP_BASE=http://localhost:4200
# Origin of the Alexa+ host simulator (allowed by CORS on /token and /.well-known/*).
HEARTH_HOST_BASE=http://localhost:3000
# Also registers ${HEARTH_HOST_BASE}/link/callback as the host simulator's redirect URI (exact match).
# Signing key. Unset = generated once into .keys/. In the cloud set a private RSA JWK (JSON string, see
# infra/cdk/scripts/gen-auth-jwk.mjs) so the key survives container restarts.
# HEARTH_AUTH_PRIVATE_JWK={"kty":"RSA",...}
