# Hearth simulated Alexa+ host (apps/host-sim). Copy to .env.local.
# Nothing here is required: with no AWS credentials the host uses the deterministic
# rules orchestrator and the browser's speech synthesis, and says so in the inspector.

# --- Browser-visible (NEXT_PUBLIC_*, inlined at build time) ---------------------------
# OAuth 2.1 authorization server (apps/auth-server). Account linking runs against it.
NEXT_PUBLIC_HEARTH_AUTH_ISSUER=http://localhost:4100
# Base URL of the Hearth MCP server (apps/mcp-server). The client talks to <base>/mcp.
NEXT_PUBLIC_HEARTH_MCP_BASE=http://localhost:4200
# Where this app is served; must match the redirect URI registered for client_id
# alexa-plus-host-sim (packages/contracts/src/auth.ts): <host>/link/callback.
NEXT_PUBLIC_HEARTH_HOST_BASE=http://localhost:3000

# --- Server-only (read by /api/orchestrate and /api/tts) -------------------------------
# AWS credentials switch the orchestrator to Bedrock Converse and TTS to Amazon Polly
# neural "Ruth". Either of these two is enough to enable them; the AWS SDK default
# credential chain (SSO, shared config, instance role) does the rest.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1
# Bedrock model or inference-profile id used by the orchestrator.
HEARTH_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Alias of HEARTH_BEDROCK_MODEL (the infra stack sets this name). HEARTH_BEDROCK_MODEL wins if both are set.
HEARTH_BEDROCK_MODEL_ID=
# Optional Bedrock Guardrail. When HEARTH_GUARDRAIL_ID is set, every Bedrock Converse call carries
# guardrailConfig { guardrailIdentifier, guardrailVersion, trace: "enabled" }. If the guardrail intervenes
# (stopReason guardrail_intervened) its blocked message is spoken. Unset: no guardrail is attached.
HEARTH_GUARDRAIL_ID=
# Guardrail version; defaults to DRAFT when empty.
HEARTH_GUARDRAIL_VERSION=

# Orchestrator order: Bedrock (if AWS credentials) -> Ollama (if reachable and the model is pulled) -> rules.
# Force one with bedrock | ollama | rules. Forcing an unavailable provider falls back to rules and the
# inspector says why. The inspector chip always shows the provider that actually answered.
HEARTH_ORCHESTRATOR=
# Local model through Ollama. The host probes GET <url>/api/tags (cached 30 s) for the model name.
HEARTH_OLLAMA_URL=http://127.0.0.1:11434
HEARTH_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Replays (?replay=J1) use the rules orchestrator so they reproduce. Opt in per URL:
#   /?replay=J1&orchestrator=ollama
# Polly voice (neural engine).
HEARTH_POLLY_VOICE=Ruth
