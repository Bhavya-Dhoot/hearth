# Hearth MCP server. Copy to .env and adjust. Every value has a working local default.

# Public URLs. HEARTH_MCP_BASE is also the token audience (${HEARTH_MCP_BASE}/mcp).
HEARTH_MCP_BASE=http://localhost:4200
HEARTH_AUTH_ISSUER=http://localhost:4100
# Override only if the auth server publishes its keys somewhere other than ${HEARTH_AUTH_ISSUER}/.well-known/jwks.json
# HEARTH_AUTH_JWKS_URL=http://localhost:4100/.well-known/jwks.json
# Browser origin of the simulated Alexa+ host (CORS). Any http://localhost:* origin is also allowed.
HEARTH_HOST_BASE=http://localhost:3000
PORT=4200

# Home graph. A JSON file by default, DynamoDB when a table name is set.
# HEARTH_DATA_FILE=./.data/home-graph.json
# HEARTH_DDB_TABLE=hearth-home-graph
# 1 = load the Okafor house on boot, 0 = never. Unset = load it only if it is missing.
# HEARTH_SEED=1

# Widgets and media built by @hearth/widgets (defaults resolve inside this repo).
# HEARTH_WIDGETS_DIR=../../packages/widgets/dist/ui
# HEARTH_MEDIA_DIR=../../packages/widgets/media

# Payments. Unset = simulated payments (pi_sim_*). A Stripe TEST key (sk_test_ or rk_test_) enables test-mode PaymentIntents.
# Live keys are refused.
# STRIPE_SECRET_KEY=sk_test_...

# Confirmation email. Unset = .eml files in .outbox/, listed at /outbox.
# RESEND_API_KEY=re_...
# HEARTH_EMAIL_FROM=Hearth <onboarding@resend.dev>
# Recipient for every confirmation (the access token carries no email). Needed when RESEND_API_KEY is set.
# HEARTH_EMAIL_TO=you@example.com
# HEARTH_OUTBOX_DIR=./.outbox
